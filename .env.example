# Copy this file to .env.local and fill values
DATABASE_URL=postgresql://user:password@localhost:5432/viksphere

# Public site URL (used for sitemap, robots.txt, and OG tags)
NEXT_PUBLIC_SITE_URL=https://viksphere.com

# ── Cloudflare R2 (production) ──────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=your_bucket_name

# R2_ENDPOINT — leave EMPTY for production (uses Cloudflare R2).
# Set to http://minio:9000 when running via docker-compose (local dev only).
R2_ENDPOINT=

# ── Cloudinary (optional — only needed for image uploads in production) ──────
# When absent, /api/upload falls back to R2/MinIO automatically.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Other optional envs
SMTP_URL=smtp://user:pass@smtp.example.com:587

# Admin auth (set in .env.local, never commit real values)
ADMIN_SECRET_KEY=            # random string used as the URL segment e.g. /xK9mQ2/admin
ADMIN_USERNAME=              # admin login username
ADMIN_PASSWORD=              # admin login password
SESSION_SECRET=              # 32+ char random string for encrypting the session cookie

